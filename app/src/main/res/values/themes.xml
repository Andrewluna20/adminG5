<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Tema claro, sin barra de acción.

        windowLightStatusBar = true hace que la hora y la batería se pinten en
        oscuro; con el fondo claro, en false no se verían.

        windowBackground es lo que se ve el primer instante, antes de que
        Compose dibuje: si se quedara oscuro, la app daría un parpadeo negro en
        cada arranque.
    -->
    <style name="Theme.TEMAdmin" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Pantalla de arranque -->
    <style name="Theme.TEMAdmin.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_deep</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.TEMAdmin</item>

        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>
